# Copy to .env. Leave everything empty to run on the built-in sample data.

# Supabase + Firebase (docs/BACKEND.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Device key for this kiosk (create one per device, see docs/BACKEND.md). Demo seed key: demo-kiosk-key
EXPO_PUBLIC_KIOSK_TOKEN=

# Or a custom REST backend instead
EXPO_PUBLIC_API_URL=
